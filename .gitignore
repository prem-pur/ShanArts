# 📦 Node modules
node_modules/

# 🧾 Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/*
!logs/.gitkeep

# 🔐 Environment / secrets — do NOT commit files that hold real values.
# Safe to commit (templates only, no secrets): env.example, client/env.example, server/env.example
# Never commit: .env, .env.*, *.env with secrets, .pem in env paths, etc.
.env
.env.*
.env.local
.env.*.local
.env.development
.env.production
.env.test
.env.staging
server/.env
client/.env
ml/.env
client/.env.development
**/.env
**/.env.*
.envrc
.direnv/
*.env

# 🐍 Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
*.egg-info/

# 🏗 Build outputs
dist/
build/

# 📁 Uploads (keep folder, ignore files)
server/public/uploads/*
!server/public/uploads/.gitkeep

# Design previews (generated at runtime; keep directory)
server/public/previews/*
!server/public/previews/.gitkeep

# Tooling caches
.eslintcache
**/.eslintcache

# 💻 IDE / Editor
.vscode/
.idea/
*.swp
*.swo
*~

# 🧹 OS files
.DS_Store
Thumbs.db

# 📦 Archives
*.tgz

# 🧪 Coverage
coverage/