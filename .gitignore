# =============================================================================
# Single repo-wide .gitignore (client / server / ml — no nested .gitignore files)
# =============================================================================

# --- Node (root + workspaces) ---
node_modules/
client/.pnp
client/.pnp.js
.pnp.js

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/*
!logs/.gitkeep

# --- Environment / secrets (never commit real values) ---
# Variable names and examples live in README.md only — do not re-add template files.
.env
.env.*
.env.local
.env.*.local
.env.development
.env.production
.env.test
.env.staging
.env.example
client/.env
client/.env.development
server/.env
ml/.env
**/.env
**/.env.*
.envrc
.direnv/
*.env
env.example

# --- Python / ML ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.pytest_cache/
.ipynb_checkpoints/
env/
venv/
.venv/
*.egg-info/

# --- Build & coverage ---
dist/
build/
coverage/

# --- Uploads & generated previews (keep dirs) ---
server/public/uploads/*
!server/public/uploads/.gitkeep
server/public/previews/*
!server/public/previews/.gitkeep

# --- Tooling & IDE ---
.eslintcache
**/.eslintcache
.vscode/
.idea/
*.swp
*.swo
*~

# --- OS ---
.DS_Store
Thumbs.db

# --- Archives & misc ---
*.tgz
