# 📦 Node modules
node_modules/

# 🧾 Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/*
!logs/.gitkeep

# 🔐 Environment variables — never commit real secrets.
# Only `*.env.example` files are templates and may be committed.
.env
.env.local
.env.*.local
.env.development
.env.production
.env.staging
server/.env
client/.env
ml/.env
client/.env.development
.envrc
.direnv/
# Any other `.env.*` variant (still allow committed templates below)
.env.*
!.env.example
!client/.env.example
!server/.env.example

# 🐍 Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
*.egg-info/

# 🏗 Build outputs
dist/
build/

# 📁 Uploads (keep folder, ignore files)
server/public/uploads/*
!server/public/uploads/.gitkeep

# Design previews (generated at runtime; keep directory)
server/public/previews/*
!server/public/previews/.gitkeep

# Tooling caches
.eslintcache
**/.eslintcache

# 💻 IDE / Editor
.vscode/
.idea/
*.swp
*.swo
*~

# 🧹 OS files
.DS_Store
Thumbs.db

# 📦 Archives
*.tgz

# 🧪 Coverage
coverage/